    "item":  [
                 {
                     "name":  "Auth",
                     "item":  [
                                  {
                                      "name":  "Registrar usuario (público)",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"username\": \"estudiante1\",\n  \"email\": \"estudiante1@utec.edu.pe\",\n  \"password\": \"Password123\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{baseUrl}}/api/v1/auth/register",
                                                                  "host":  [
                                                                               "{{baseUrl}}"
                                                                           ],
                                                                  "path":  [
                                                                               "api",
                                                                               "v1",
                                                                               "auth",
                                                                               "register"
                                                                           ]
                                                              },
                                                      "description":  "Crea una cuenta nueva con rol ROLE_USER. No requiere token. La contraseña debe tener mínimo 8 caracteres con al menos una letra y un número. El test guarda `token` y `refreshToken` en las variables de la colección."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "const jsonData = pm.response.json();",
                                                                                    "pm.collectionVariables.set(\u0027token\u0027, jsonData.token);",
                                                                                    "pm.collectionVariables.set(\u0027refreshToken\u0027, jsonData.refreshToken);"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Iniciar sesión (público)",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"username\": \"estudiante1\",\n  \"password\": \"Password123\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{baseUrl}}/api/v1/auth/login",
                                                                  "host":  [
                                                                               "{{baseUrl}}"
                                                                           ],
                                                                  "path":  [
                                                                               "api",
                                                                               "v1",
                                                                               "auth",
                                                                               "login"
                                                                           ]
                                                              },
                                                      "description":  "Autentica al usuario y devuelve un access token y un refresh token. El test guarda ambos en las variables de la colección."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "const jsonData = pm.response.json();",
                                                                                    "pm.collectionVariables.set(\u0027token\u0027, jsonData.token);",
                                                                                    "pm.collectionVariables.set(\u0027refreshToken\u0027, jsonData.refreshToken);"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Renovar access token",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                                                               },
                                                      "url":  {
                                                                  "raw":  "{{baseUrl}}/api/v1/auth/refresh",
                                                                  "host":  [
                                                                               "{{baseUrl}}"
                                                                           ],
                                                                  "path":  [
                                                                               "api",
                                                                               "v1",
                                                                               "auth",
                                                                               "refresh"
                                                                           ]
                                                              },
                                                      "description":  "Intercambia un refresh token por un par de tokens nuevo. El refresh token no puede usarse directamente en endpoints protegidos."
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "const jsonData = pm.response.json();",
                                                                                    "pm.collectionVariables.set(\u0027token\u0027, jsonData.token);",
                                                                                    "pm.collectionVariables.set(\u0027refreshToken\u0027, jsonData.refreshToken);"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   }
                                                    }
                                                ]
                                  }
                              ]
